@page "{id:guid}"
@model Aserta.Web.Pages.Clientes.FichaModel
@{
    var c = Model.Cliente;
    ViewData["Titulo"] = c.NombreParaMostrar;
    string Pest(string p) => Model.Pestana == p ? "page" : null!;
}
<div class="migas"><a asp-page="/Clientes/Index">Clientes</a> › @c.NombreParaMostrar</div>
<div class="pagina-cabecera">
    <div>
        <h1>@c.NombreParaMostrar
            @if (c.Estado == EstadoCliente.Baja) { <span class="insignia">Baja @c.FechaBaja?.ToString("dd/MM/yyyy")</span> }
        </h1>
        <p class="subtitulo"><span class="mono">@c.Nif</span> · @c.FormaJuridica · Asesor: @Model.NombreAsesor · Alta @c.FechaAlta.ToString("dd/MM/yyyy")</p>
    </div>
    <div class="acciones">
        <a class="boton" asp-page="/Clientes/Editar" asp-route-id="@c.Id">@Icono.Editar Editar datos</a>
        <a class="boton" asp-page="/Clientes/PerfilFiscal" asp-route-id="@c.Id">Nueva versión del perfil</a>
        <form method="post" asp-page-handler="Regenerar" asp-route-id="@c.Id">
            <button type="submit" class="boton" title="Reejecuta el motor de reglas (idempotente)">@Icono.Refrescar Recalcular obligaciones</button>
        </form>
    </div>
</div>

<div class="rejilla rejilla-4 mb-4">
    <div class="panel kpi"><div class="kpi-valor">@Model.Abiertas</div><div class="kpi-etiqueta">Obligaciones abiertas</div></div>
    <div class="panel kpi"><div class="kpi-valor">@Model.VencenEn30</div><div class="kpi-etiqueta">Vencen en 30 días</div></div>
    <div class="panel kpi"><div class="kpi-valor">@Model.Vencidas</div><div class="kpi-etiqueta">Vencidas sin presentar</div></div>
    <div class="panel kpi"><div class="kpi-valor">@Model.Cerradas</div><div class="kpi-etiqueta">Presentadas o cerradas</div></div>
</div>

<nav class="pestanas" aria-label="Secciones de la ficha">
    <a asp-page="/Clientes/Ficha" asp-route-id="@c.Id" asp-route-pestana="resumen" aria-current="@Pest("resumen")">Resumen</a>
    <a asp-page="/Clientes/Ficha" asp-route-id="@c.Id" asp-route-pestana="obligaciones" aria-current="@Pest("obligaciones")">Obligaciones <span class="insignia">@Model.Obligaciones.Count</span></a>
    <a asp-page="/Clientes/Ficha" asp-route-id="@c.Id" asp-route-pestana="documentacion" aria-current="@Pest("documentacion")">Documentación @if (Model.Faltantes > 0) { <span class="insignia insignia-aviso">faltan @Model.Faltantes</span> }</a>
    <a asp-page="/Clientes/Ficha" asp-route-id="@c.Id" asp-route-pestana="perfil" aria-current="@Pest("perfil")">Perfil fiscal <span class="insignia">@c.Perfiles.Count</span></a>
    <a asp-page="/Clientes/Ficha" asp-route-id="@c.Id" asp-route-pestana="historial" aria-current="@Pest("historial")">Historial</a>
</nav>

@if (Model.Pestana == "resumen")
{
    <div class="rejilla rejilla-2">
        <div class="panel">
            <div class="panel-cabecera"><h2>Datos</h2></div>
            <div class="panel-cuerpo">
                <dl class="datos">
                    <dt>Razón social</dt><dd>@c.RazonSocial</dd>
                    <dt>Nombre comercial</dt><dd>@(c.NombreComercial ?? "—")</dd>
                    <dt>NIF</dt><dd class="mono">@c.Nif</dd>
                    <dt>Forma jurídica</dt><dd>@c.FormaJuridica</dd>
                    <dt>Correo</dt><dd>@(c.Email ?? "—")</dd>
                    <dt>Teléfono</dt><dd>@(c.Telefono ?? "—")</dd>
                    <dt>Dirección</dt><dd>@string.Join(", ", new[] { c.DireccionCalle, c.DireccionCodigoPostal, c.DireccionMunicipio, c.DireccionProvincia }.Where(s => !string.IsNullOrWhiteSpace(s)))</dd>
                    <dt>Asesor responsable</dt><dd>@Model.NombreAsesor</dd>
                    <dt>Alta / baja</dt><dd>@c.FechaAlta.ToString("dd/MM/yyyy") @(c.FechaBaja is { } fb ? $"→ {fb:dd/MM/yyyy}" : "")</dd>
                    <dt>Notas</dt><dd>@(c.Notas ?? "—")</dd>
                </dl>
            </div>
        </div>
        <div class="panel">
            <div class="panel-cabecera"><h2>Perfil fiscal vigente</h2><a class="texto-sm" asp-page="/Clientes/Ficha" asp-route-id="@c.Id" asp-route-pestana="perfil">Ver versiones</a></div>
            <div class="panel-cuerpo">
                @if (c.PerfilActual is { } p)
                {
                    <partial name="_PerfilResumen" model="p" />
                }
                else { <p class="vacio">Sin perfil fiscal.</p> }
            </div>
        </div>
    </div>
    <div class="panel mt-4">
        <div class="panel-cabecera"><h2>Próximos vencimientos</h2><a class="texto-sm" asp-page="/Clientes/Ficha" asp-route-id="@c.Id" asp-route-pestana="obligaciones">Ver todas</a></div>
        <partial name="_TablaObligaciones" model="Model.Proximas" view-data="@(new ViewDataDictionary(ViewData) { ["Hoy"] = Model.Hoy })" />
    </div>
}
else if (Model.Pestana == "obligaciones")
{
    @foreach (var grupo in Model.Obligaciones.GroupBy(o => o.Ejercicio).OrderBy(g => g.Key))
    {
        <div class="panel mb-4">
            <div class="panel-cabecera"><h2>Ejercicio @grupo.Key</h2><span class="texto-3 texto-sm">@grupo.Count(o => o.Estado != EstadoObligacion.NoAplica) obligaciones</span></div>
            <partial name="_TablaObligaciones" model="grupo.OrderBy(o => Semaforo.FechaDeReferencia(o)).ThenBy(o => o.ModeloCodigo).ToList()" view-data="@(new ViewDataDictionary(ViewData) { ["Hoy"] = Model.Hoy })" />
        </div>
    }
    @if (Model.Obligaciones.Count == 0) { <div class="panel"><p class="vacio">Este cliente no tiene obligaciones generadas. Compruebe el perfil fiscal o pulse «Recalcular obligaciones».</p></div> }
}
else if (Model.Pestana == "documentacion")
{
    <partial name="_ResumenErrores" />
    <div class="panel mb-4">
        <div class="panel-cabecera"><h2>Qué esperamos recibir</h2><span class="texto-3 texto-sm">Derivado del perfil fiscal; ajustable cliente a cliente. Es lo que el portal traduce a «te faltan 2 facturas de julio».</span></div>
        <div class="tabla-envoltorio"><table class="tabla tabla-compacta">
            <thead><tr><th>Periodo</th><th>Documento</th><th>Recibidos / esperados</th><th>Estado</th><th>Obligatorio</th><th><span class="oculto-visualmente">Ajustar</span></th></tr></thead>
            <tbody>
            @foreach (var e in Model.Requisitos.Where(r => Periodo.Rango(r.Requisito.Ejercicio, r.Requisito.Periodo).Inicio >= Model.Hoy.AddMonths(-6)).OrderByDescending(r => r.Requisito.Ejercicio).ThenByDescending(r => Periodo.Orden(r.Requisito.Periodo)).ThenBy(r => r.Requisito.TipoDocumento))
            {
                <tr class="@(e.Requisito.NoAplica ? "texto-3" : "")">
                    <td class="nowrap">@Periodo.Etiqueta(e.Requisito.Ejercicio, e.Requisito.Periodo)</td>
                    <td>@e.Requisito.Descripcion<br /><small class="texto-3">@e.Requisito.TipoDocumento.Etiqueta()</small></td>
                    <td class="tabular">@e.Recibidos / @(e.Requisito.CantidadEsperada?.ToString() ?? "≥1") @if (e.Rechazados > 0) { <small class="texto-3">(@e.Rechazados rechazados)</small> }</td>
                    <td>@if (e.Requisito.NoAplica) { <span class="insignia">No aplica</span> } else if (e.Completo) { <span class="insignia insignia-ok">Completo</span> } else { <span class="insignia insignia-aviso">@e.Frase</span> }</td>
                    <td>@(e.Requisito.Obligatorio ? "Sí" : "No")</td>
                    <td class="texto-derecha">
                        <form method="post" asp-page-handler="AjustarRequisito" asp-route-id="@c.Id" asp-route-requisitoId="@e.Requisito.Id" class="flex nowrap">
                            <input class="entrada" type="number" name="cantidad" value="@e.Requisito.CantidadEsperada" min="0" max="999" placeholder="≥1" aria-label="Cantidad esperada" size="3" />
                            <label class="texto-xs nowrap"><input type="checkbox" name="obligatorio" value="true" checked="@e.Requisito.Obligatorio" /> oblig.</label>
                            <label class="texto-xs nowrap"><input type="checkbox" name="noAplica" value="true" checked="@e.Requisito.NoAplica" /> no aplica</label>
                            <button class="boton boton-pequeno">Guardar</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody></table></div>
        <div class="panel-cuerpo">
            <form method="post" asp-page-handler="AnadirRequisito" asp-route-id="@c.Id" class="flex">
                <span class="texto-sm medio">Añadir requisito:</span>
                <input class="entrada" type="number" name="ejercicio" value="@Model.Hoy.Year" min="2020" max="2100" aria-label="Ejercicio" size="5" />
                <select name="periodo" aria-label="Periodo">@foreach (var m in Periodo.Meses) { <option value="@m" selected="@(m == Model.Hoy.AddMonths(-1).Month.ToString("00"))">@System.Globalization.CultureInfo.GetCultureInfo("es-ES").DateTimeFormat.GetMonthName(int.Parse(m))</option> }@foreach (var t in Periodo.Trimestres) { <option value="@t">@t</option> }</select>
                <select name="tipo" aria-label="Tipo de documento">@foreach (var t in Enum.GetValues<TipoDocumento>()) { <option value="@t">@t.Etiqueta()</option> }</select>
                <input class="entrada" type="number" name="cantidad" min="1" max="999" placeholder="cantidad" aria-label="Cantidad" size="4" />
                <input class="entrada" name="descripcion" placeholder="Descripción para el cliente" aria-label="Descripción" />
                <button class="boton boton-pequeno">Añadir</button>
            </form>
        </div>
    </div>
    <div class="panel">
        <div class="panel-cabecera"><h2>Documentos recibidos</h2><a class="boton boton-pequeno" asp-page="/Documentos/Subir" asp-route-clienteId="@c.Id">Registrar documento</a></div>
        <div class="tabla-envoltorio"><table class="tabla tabla-compacta">
            <thead><tr><th>Recibido</th><th>Documento</th><th>Tipo · periodo</th><th>Estado</th></tr></thead>
            <tbody>
            @if (Model.Documentos.Count == 0) { <tr><td colspan="4" class="vacio">Sin documentos.</td></tr> }
            @foreach (var d in Model.Documentos)
            {
                <tr data-href="/Documentos/Detalle/@d.Id">
                    <td class="tabular nowrap">@d.FechaSubidaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td><a asp-page="/Documentos/Detalle" asp-route-id="@d.Id">@d.NombreOriginal</a></td>
                    <td>@d.Tipo.Etiqueta() · @Periodo.Etiqueta(d.Ejercicio, d.Periodo)</td>
                    <td><span class="insignia @(d.Estado switch { EstadoDocumento.Validado => "insignia-ok", EstadoDocumento.Rechazado => "insignia-error", EstadoDocumento.EnRevision => "insignia-info", _ => "" })">@d.Estado.Etiqueta()</span></td>
                </tr>
            }
            </tbody></table></div>
    </div>
}
else if (Model.Pestana == "perfil")
{
    @foreach (var p in c.Perfiles.OrderByDescending(p => p.VigenteDesde))
    {
        <div class="panel mb-4">
            <div class="panel-cabecera">
                <h2>Desde @p.VigenteDesde.ToString("dd/MM/yyyy") @(p.VigenteHasta is { } h ? $"hasta {h:dd/MM/yyyy}" : "") </h2>
                @if (p.VigenteHasta is null) { <span class="insignia insignia-ok">Vigente</span> } else { <span class="insignia">Histórico</span> }
            </div>
            <div class="panel-cuerpo"><partial name="_PerfilResumen" model="p" /></div>
        </div>
    }
}
else
{
    <div class="panel">
        <div class="panel-cabecera"><h2>Auditoría del cliente</h2><span class="texto-3 texto-sm">Quién, qué, cuándo y desde dónde (RD-08)</span></div>
        <div class="panel-cuerpo">
            @if (Model.Auditoria.Count == 0) { <p class="vacio">Sin registros.</p> }
            <ol class="linea-tiempo">
                @foreach (var a in Model.Auditoria)
                {
                    <li>
                        <time datetime="@a.FechaUtc.ToString("O")">@a.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                        <strong>@a.Accion</strong> · @a.EntidadTipo
                        <span class="autor">· @(Model.NombresUsuarios.GetValueOrDefault(a.UsuarioId ?? Guid.Empty, "sistema"))</span>
                        @if (a.DireccionIp is not null) { <span class="texto-3">· @a.DireccionIp</span> }
                        @if (a.Detalle is not null) { <details><summary class="texto-xs texto-3">detalle</summary><code class="texto-xs">@a.Detalle</code></details> }
                    </li>
                }
            </ol>
        </div>
    </div>
}
