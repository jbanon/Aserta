@model IReadOnlyList<Aserta.Dominio.Mensajeria.Hilo>
@using Aserta.Aplicacion.Puertos
@inject IContextoUsuarioActual Usuario
@{
    bool esCliente = Usuario.ClienteId is not null;
}
@if (Model.Count == 0) { <p class="texto-3 texto-sm">Sin mensajes.</p> }
<ul class="lista-hilos">
@foreach (var h in Model)
{
    var ultimo = h.Mensajes.LastOrDefault();
    int sinLeer = h.Mensajes.Count(m => esCliente ? m.LeidoPorClienteUtc is null : m.LeidoPorGestoriaUtc is null);
    <li class="@(sinLeer > 0 ? "aviso-no-leido" : "")">
        <a asp-page="/Mensajes/Hilo" asp-route-id="@h.Id">@h.Asunto</a>
        @if (sinLeer > 0) { <span class="insignia insignia-marca">@sinLeer sin leer</span> }
        @if (h.Estado == Aserta.Dominio.Mensajeria.EstadoHilo.Cerrado) { <span class="insignia">Cerrado</span> }
        <br /><small class="texto-3">@h.FechaUltimoMensajeUtc.ToLocalTime().ToString("dd/MM HH:mm") · @(ultimo is null ? "" : (ultimo.Cuerpo.Length > 90 ? ultimo.Cuerpo[..90] + "…" : ultimo.Cuerpo))</small>
    </li>
}
</ul>
