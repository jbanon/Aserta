@page
@model Aserta.Web.Pages.Cuenta.PerfilModel
@{
    ViewData["Titulo"] = "Mi cuenta";
}
<div class="pagina-cabecera"><div><h1>Mi cuenta</h1><p class="subtitulo">@Model.Email · @string.Join(", ", Model.Roles)</p></div></div>
<partial name="_ResumenErrores" />
<div class="rejilla rejilla-2">
    <div class="panel"><div class="panel-cabecera"><h2>Segundo factor</h2>@if (Model.MfaActivo) { <span class="insignia insignia-ok">Activo</span> } else { <span class="insignia insignia-aviso">No activo</span> }</div>
        <div class="panel-cuerpo columna">
            @if (Model.MfaActivo)
            {
                <p class="texto-sm texto-2">Códigos de recuperación restantes: @Model.CodigosRestantes</p>
                <form method="post" asp-page-handler="RegenerarCodigos"><button class="boton">Generar códigos de recuperación nuevos</button></form>
                @if (Model.CodigosNuevos is not null) { <ul class="mono texto-sm">@foreach (var c in Model.CodigosNuevos) { <li>@c</li> }</ul> }
                @if (!Model.MfaObligatorio) { <form method="post" asp-page-handler="Desactivar" data-confirmar="¿Desactivar el segundo factor?"><button class="boton boton-peligro">Desactivar</button></form> }
                else { <p class="texto-xs texto-3">Su gestoría exige el segundo factor: no se puede desactivar.</p> }
            }
            else
            {
                <p class="texto-sm texto-2">Proteja su cuenta con una aplicación autenticadora.</p>
                <a class="boton boton-primario" asp-page="/Cuenta/Mfa/Configurar">Activar segundo factor</a>
            }
        </div></div>
    <div class="panel"><div class="panel-cabecera"><h2>Cambiar contraseña</h2></div>
        <div class="panel-cuerpo">
            <form method="post" asp-page-handler="Contrasena" class="columna">
                <div class="campo"><label asp-for="Actual">Contraseña actual</label><input class="entrada" type="password" asp-for="Actual" autocomplete="current-password" required /></div>
                <div class="campo"><label asp-for="Nueva">Nueva contraseña</label><input class="entrada" type="password" asp-for="Nueva" autocomplete="new-password" required /><span class="ayuda">Mínimo 10 caracteres con mayúscula y número.</span></div>
                <div class="campo"><label asp-for="Repetir">Repetir nueva contraseña</label><input class="entrada" type="password" asp-for="Repetir" autocomplete="new-password" required /></div>
                <div><button class="boton boton-primario">Cambiar</button></div>
            </form>
        </div></div>
</div>
