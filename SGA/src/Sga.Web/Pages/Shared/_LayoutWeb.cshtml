<!DOCTYPE html>
<html lang="es">
<head>
    <script src="/js/js.js" asp-append-version="true"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    @{
        var tituloPagina = ViewData["Titulo"] is string t ? t + " · SGA Contabilizado" : "SGA Contabilizado · Gestoría en Alcorcón";
        var descripcion = ViewData["Descripcion"] as string ?? "Gestoría en Alcorcón para arrendadores, autónomos y pequeñas sociedades. Tus impuestos al día, con un área de clientes que te dice qué falta y cuánto vas a pagar.";
        var indexable = Seo.EsIndexable(Context.Request);
        var canonica = Seo.Canonica(Context.Request.Path);
        var origen = Context.Request.Scheme + "://" + Context.Request.Host;
    }
    <title>@tituloPagina</title>
    <meta name="description" content="@descripcion" />
    <link rel="canonical" href="@canonica" />
    @if (!indexable) { <meta name="robots" content="noindex, nofollow" /> }
    @if (Seo.VerificacionGoogle is { Length: > 0 } verificacion) { <meta name="google-site-verification" content="@verificacion" /> }
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="SGA Contabilizado" />
    <meta property="og:title" content="@tituloPagina" />
    <meta property="og:description" content="@descripcion" />
    <meta property="og:url" content="@canonica" />
    <meta property="og:image" content="@origen/img/sga-tarjeta.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <partial name="_DatosLocales" />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/sga.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/fotos.css" asp-append-version="true" />
    <meta name="theme-color" content="#4A3470" />
</head>
<body class="con-barra-movil">
    <a class="visualmente-oculto" href="#contenido">Saltar al contenido</a>
    <header class="web-cabecera">
        <div class="contenedor">
            <a class="marca" href="/" aria-label="SGA Contabilizado, inicio"><img src="/img/sga-compacto.svg" alt="" width="104" height="40" /><span class="visualmente-oculto">SGA Contabilizado</span></a>
            @{ var ruta = Context.Request.Path.Value ?? "/"; string Actual(string p) => (p == "/" ? ruta == "/" : ruta.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? "page" : null!; }
            <nav class="web-nav" aria-label="Principal">
                <a href="/servicios" aria-current="@Actual("/servicios")">Servicios</a>
                <a href="/como-trabajamos" aria-current="@Actual("/como-trabajamos")">Cómo trabajamos</a>
                <a href="/equipo" aria-current="@Actual("/equipo")">Equipo</a>
                <a href="/contacto" aria-current="@Actual("/contacto")">Contacto</a>
                <a class="boton boton-marca" href="/acceso" style="margin-left:8px">Área de clientes</a>
            </nav>
            <button class="boton boton-icono boton-sutil web-menu-boton" type="button" data-menu aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir el menú"><partial name="_Icono" model='"menu"'  /></button>
        </div>
        <nav id="menu-movil" class="web-menu-movil" aria-label="Principal (móvil)">
            <a href="/servicios">Servicios</a><a href="/como-trabajamos">Cómo trabajamos</a><a href="/equipo">Equipo</a><a href="/contacto">Contacto</a>
            <a class="boton boton-marca" href="/acceso">Área de clientes</a>
        </nav>
    </header>
    <main id="contenido">
        @RenderBody()
    </main>
    <footer class="pie">
        <div class="contenedor">
            <div>
                <img src="/img/sga-logo-oscuro.svg" alt="SGA Contabilizado" width="260" height="100" style="height:auto;max-width:260px" />
                <p class="mt-4" style="max-width:38ch">Gestoría para arrendadores, autónomos y pequeñas sociedades. Cuentas claras, plazos cumplidos y una persona con nombre al otro lado.</p>
            </div>
            <div><h4>Servicios</h4><ul><li><a href="/servicios#arrendadores">Arrendadores</a></li><li><a href="/servicios#autonomos">Autónomos y profesionales</a></li><li><a href="/servicios#sociedades">Sociedades</a></li></ul>
                <h4 class="mt-4">Guías para Alcorcón</h4><ul><li><a href="/alcorcon/alquiler-de-local-impuestos">Alquiler de un local</a></li><li><a href="/alcorcon/autonomo-plazos-del-trimestre">Autónomo: plazos del trimestre</a></li><li><a href="/alcorcon/sociedad-obligaciones-fiscales">Pequeña sociedad</a></li></ul></div>
            <div><h4>SGA</h4><ul><li><a href="/como-trabajamos">Cómo trabajamos</a></li><li><a href="/equipo">Equipo</a></li><li><a href="/contacto">Contacto</a></li><li><a href="/acceso">Área de clientes</a></li></ul></div>
            <div><h4>Dónde estamos</h4>
                @{ var nap = OpcionesSga.Value; }
                <address class="nap">
                    <div>@nap.Direccion <partial name="_Verificar" /><br />@nap.CodigoPostal @nap.Localidad (Madrid)</div>
                    <div><a href="tel:+34@nap.Telefono.Replace(" ", "")">@nap.Telefono</a> <partial name="_Verificar" /></div>
                    <div><a href="mailto:@nap.Email">@nap.Email</a></div>
                    <div>@nap.Horario <partial name="_Verificar" /></div>
                </address></div>
            <div class="legal">© @Reloj.Hoy.Year SGA Contabilizado · Demostración con datos ficticios: nombres, NIF, importes y contactos son inventados. Ninguna presentación se envía a la Agencia Tributaria.</div>
        </div>
    </footer>
    <nav class="barra-movil" aria-label="Acciones rápidas">
        <a href="tel:@OpcionesSga.Value.Telefono.Replace(" ", "")"><partial name="_Icono" model='"telefono"' /><span>Llamar</span></a>
        <a href="https://wa.me/34@OpcionesSga.Value.Telefono.Replace(" ", "")" rel="noopener"><partial name="_Icono" model='"mensajes"' /><span>WhatsApp</span></a>
        <a class="principal" href="/acceso"><partial name="_Icono" model='"llave"' /><span>Área de clientes</span></a>
    </nav>
    <script src="/js/app.js" asp-append-version="true"></script>
</body>
</html>
